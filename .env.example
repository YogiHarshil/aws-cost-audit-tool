# AWS Configuration
# Credentials live in ~/.aws/ (from `aws configure` or SSO). This file only selects which profile to use.
# List profiles: aws configure list-profiles
# Test auth:      aws sts get-caller-identity --profile YOUR_PROFILE_NAME
#
# AWS_PROFILE must match a profile in ~/.aws/credentials or ~/.aws/config (SSO).
# There is no fallback to env/instance credentials if the profile is wrong — avoids auditing the wrong account.
AWS_PROFILE=default
# Optional: assume a read-only audit role (base creds from AWS_PROFILE / default chain).
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/CostAuditRole
# Optional: limit regions (comma-separated). Used by config.py / future CLI.
# REGIONS=us-east-1,us-west-2

# OpenAI Configuration (required unless using --skip-ai flag)
# Official OpenAI:
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
#
# OpenRouter (use their key sk-or-v1-... + base URL; model slug must match their site):
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-oss-120b:free
# (Free tier can be slower; for stricter JSON in recommendations, try openai/gpt-4o-mini.)
#
# Optional — reasoning models (e.g. gpt-oss-120b): set one of:
# OPENROUTER_REASONING=true
#   (adds extra_body reasoning when OPENAI_BASE_URL is OpenRouter; see OpenRouter model docs)
# For faster/cheaper routine runs: omit OPENROUTER_REASONING or set OPENROUTER_REASONING=false,
# and use a smaller model (e.g. OPENAI_MODEL=openai/gpt-4o-mini on OpenRouter).
# OPENAI_EXTRA_BODY={"reasoning":{"enabled":true}}
#   (JSON object; overrides OPENROUTER_REASONING when both are set)
#
# Optional — OpenRouter leaderboard attribution headers:
# OPENROUTER_HTTP_REFERER=https://your-site.example/
# OPENROUTER_APP_TITLE=AWS Cost Audit Tool
OPENAI_API_KEY=sk-proj-your-key-here

# Client Configuration
CLIENT_NAME=Acme Corporation

# Scan Configuration
# Comma-separated tag filters to exclude resources (e.g., "Environment=Production,Critical=true")
EXCLUDE_TAGS=

# Output directory for PDF reports
OUTPUT_DIR=./output

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
