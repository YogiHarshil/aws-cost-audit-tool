# AWS Configuration - FOR SCANNING CLIENT'S ACCOUNT
# This profile/role is used to scan the client's AWS resources
AWS_PROFILE=default
# Optional: assume a read-only audit role in client's account
# AWS_ROLE_ARN=arn:aws:iam::CLIENT_ACCOUNT_ID:role/CostAuditRole

# Optional: limit regions (comma-separated)
# REGIONS=us-east-1,us-west-2

# ============================================================================
# AI Configuration - Choose ONE option
# ============================================================================

# OPTION 1: AWS Bedrock (Recommended for cross-account audits)
#
# IMPORTANT: Bedrock uses a SEPARATE profile from scanning!
# - AWS_PROFILE = Client's account (for scanning their resources)
# - BEDROCK_PROFILE = YOUR account (for AI summaries - you pay)
#
# This means:
# ✓ Client doesn't need Bedrock enabled
# ✓ You control AI costs
# ✓ Works with any client account
#
USE_BEDROCK=true
BEDROCK_PROFILE=your-bedrock-profile
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1

# OPTION 2: OpenAI Direct (external API)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# OPTION 3: OpenRouter (external API)
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# OPTION 4: No AI (leave OPENAI_API_KEY empty, USE_BEDROCK=false)
# Faster scans, no AI costs

# ============================================================================
# Client & Output Configuration
# ============================================================================

CLIENT_NAME=Acme Corporation
OUTPUT_DIR=./output
EXCLUDE_TAGS=
LOG_LEVEL=INFO
